NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Use your machine's LAN IP so other devices on the network can reach the API
# e.g. NEXT_PUBLIC_API_URL=http://10.0.0.174:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# true = only ADMIN_EMAILS users can use admin UI (production)
# false = any Google login can use admin UI (local dev)
NEXT_PUBLIC_REQUIRE_ADMIN=true
