DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scoreivy

# Random value, at least 32 chars: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SECRET_KEY=

# Same OAuth client ID the frontends use (comma-separate if the apps use different clients)
GOOGLE_CLIENT_ID=

# Comma-separated admin emails
ADMIN_EMAILS=

# development (default) or production. production disables dev login, SKIP_ADMIN_AUTH,
# free purchases, sample data, and /docs, and refuses to start with unsafe settings.
ENV=development

# Required in production: comma-separated frontend origins
# CORS_ORIGINS=https://scoreivy.com,https://admin.scoreivy.com

# Dev only (ignored when ENV=production)
# SKIP_ADMIN_AUTH=true
# DEV_LOGIN_EMAIL=dev@scoreivy.local
# ALLOW_FREE_PURCHASE=true
# LOAD_SAMPLE_DATA=true
